{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,

    // Enforces the portability rule in AGENTS.md mechanically: no enum, no
    // namespace with runtime code, no constructor parameter properties. Keeps
    // the source runnable by Node's type stripping and by any bundler.
    "erasableSyntaxOnly": true,

    // Relative imports are written with explicit .ts extensions; tsc rewrites
    // them to .js on emit.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,

    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
