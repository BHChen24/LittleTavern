{
  "name": "littletavern",
  "version": "1.0.0",
  "description": "A terminal (TUI) app for character-card roleplay chat.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "tsc -b",
    "build:watch": "tsc -b --watch",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "pino-pretty": "^13.1.3",
    "react-devtools-core": "^7.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
